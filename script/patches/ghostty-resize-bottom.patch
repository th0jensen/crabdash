+/// Allocate a blank prefix without moving existing rows or tracked pins.
+/// The complete prefix is allocated before linking it into the live list.
+fn prependBlankRows(self: *PageList, count: usize) Allocator.Error!void {
+    if (count == 0) return;
+    var prefix: List = .{};
+    errdefer while (prefix.popFirst()) |node| self.destroyNode(node);
+    const cap = initialCapacity(self.cols);
+    var remaining = count;
+    while (remaining > 0) {
+        const node = try self.createPage(.{ .cap = cap });
+        node.page().size.rows = @intCast(@min(remaining, node.capacity().rows));
+        remaining -= node.rows();
+        prefix.append(node);
+    }
+    while (prefix.pop()) |node| self.pages.prepend(node);
+    self.total_rows += count;
+    self.viewport_pin_row_offset = null;
+}

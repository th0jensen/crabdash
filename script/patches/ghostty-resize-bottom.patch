+test "PageList anchored growth prepends blanks and preserves tracked content" {
+    const testing = std.testing;
+    var list = try init(testing.allocator, .{ .cols = 5, .rows = 3 });
+    defer list.deinit();
+    for (0..3) |y| {
+        const cell = list.getCell(.{ .active = .{ .x = 0, .y = @intCast(y) } }).?.cell;
+        cell.* = .{
+            .content_tag = .codepoint,
+            .content = .{ .codepoint = .{ .data = @intCast('A' + y) } },
+        };
+    }
+    const tracked = try list.trackPin(list.pin(.{ .active = .{ .x = 0, .y = 1 } }).?);
+    defer list.untrackPin(tracked);
+    try list.resize(.{
+        .rows = 6,
+        .anchor_bottom = true,
+        .cursor = .{ .x = 0, .y = 1, .pin = tracked },
+    });
+    try testing.expectEqual(@as(usize, 6), list.totalRows());
+    try testing.expectEqual(@as(u32, 4), list.pointFromPin(.active, tracked.*).?.active.y);
+    for (0..3) |y| {
+        const cell = list.getCell(.{ .active = .{ .x = 0, .y = @intCast(y) } }).?.cell;
+        try testing.expectEqual(@as(u21, 0), cell.content.codepoint.data);
+        const content = list.getCell(.{ .active = .{ .x = 0, .y = @intCast(y + 3) } }).?.cell;
+        try testing.expectEqual(@as(u21, @intCast('A' + y)), content.content.codepoint.data);
+    }
+    try list.resize(.{ .rows = 2, .anchor_bottom = true });
+    try testing.expectEqual(@as(u32, 0), list.pointFromPin(.active, tracked.*).?.active.y);
+    try list.resize(.{ .rows = 6, .anchor_bottom = true });
+    try testing.expectEqual(@as(usize, 6), list.totalRows());
+    try testing.expectEqual(@as(u32, 4), list.pointFromPin(.active, tracked.*).?.active.y);
+    list.assertIntegrity();
+}

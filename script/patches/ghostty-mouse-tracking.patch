+
+test "encode: repeated options preserve cell tracking and changes invalidate it" {
+    const terminal_c = @import("terminal.zig");
+    const Report = struct {
+        fn run(encoder: Encoder, event: Event, buf: []u8) ![]const u8 {
+            var written: usize = 0;
+            try testing.expectEqual(Result.success, encode(
+                encoder,
+                event,
+                buf.ptr,
+                buf.len,
+                &written,
+            ));
+            return buf[0..written];
+        }
+    };
+    var encoder: Encoder = undefined;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &encoder));
+    defer free(encoder);
+    var terminal: Terminal = undefined;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &terminal, 80, 24));
+    defer terminal_c.free(terminal);
+    const t = terminal.?.terminal;
+    t.flags.mouse_event = .button;
+    t.flags.mouse_format = .sgr;
+    var size = testSize();
+    size.cell_width = 10;
+    size.cell_height = 10;
+    const track_last_cell = true;
+    const pressed = true;
+    setopt(encoder, .track_last_cell, &track_last_cell);
+    setopt(encoder, .any_button_pressed, &pressed);
+    setopt_from_terminal(encoder, terminal);
+    setopt(encoder, .size, &size);
+
+    var event: Event = undefined;
+    try testing.expectEqual(Result.success, mouse_event.new(&lib.alloc.test_allocator, &event));
+    defer mouse_event.free(event);
+    mouse_event.set_button(event, .left);
+    mouse_event.set_position(event, .{ .x = 5, .y = 6 });
+    var buf: [64]u8 = undefined;
+    try testing.expect((try Report.run(encoder, event, &buf)).len > 0);
+    mouse_event.set_action(event, .motion);
+    setopt_from_terminal(encoder, terminal);
+    setopt(encoder, .size, &size);
+    try testing.expectEqual(@as(usize, 0), (try Report.run(encoder, event, &buf)).len);
+    mouse_event.set_position(event, .{ .x = 6, .y = 6 });
+    try testing.expectEqual(@as(usize, 0), (try Report.run(encoder, event, &buf)).len);
+    mouse_event.set_position(event, .{ .x = 15, .y = 6 });
+    try testing.expect((try Report.run(encoder, event, &buf)).len > 0);
+
+    // Geometry and effective terminal flags invalidate the tracked cell.
+    size.screen_width += 10;
+    setopt(encoder, .size, &size);
+    try testing.expect((try Report.run(encoder, event, &buf)).len > 0);
+    t.flags.mouse_event = .any;
+    setopt_from_terminal(encoder, terminal);
+    try testing.expect((try Report.run(encoder, event, &buf)).len > 0);
+    t.flags.mouse_format = .sgr_pixels;
+    setopt_from_terminal(encoder, terminal);
+    try testing.expectEqualStrings("\x1b[<32;15;6M", try Report.run(encoder, event, &buf));
+    // Pixel motion must report within a cell, even after refreshing options.
+    mouse_event.set_position(event, .{ .x = 16, .y = 6 });
+    setopt_from_terminal(encoder, terminal);
+    setopt(encoder, .size, &size);
+    try testing.expectEqualStrings("\x1b[<32;16;6M", try Report.run(encoder, event, &buf));
+    t.flags.mouse_format = .sgr;
+    setopt_from_terminal(encoder, terminal);
+    try testing.expect((try Report.run(encoder, event, &buf)).len > 0);
+    try testing.expectEqual(@as(usize, 0), (try Report.run(encoder, event, &buf)).len);
+}
